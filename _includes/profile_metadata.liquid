{% assign profile = site.data.profile %}
{% if profile.name %}
  {% assign author_name = profile.name %}
{% else %}
  {% capture author_name %}{{ site.first_name }} {{ site.last_name }}{% endcapture %}
{% endif %}
{% assign page_description = page.description | default: profile.description | default: site.description | strip_newlines | strip %}
{% if page.url == '/' %}
  {% capture page_title %}{{ profile.name }} — {{ profile.job_title }} at {{ profile.employer.name }}{% endcapture %}
{% elsif page.title and page.title != 'blank' %}
  {% capture page_title %}{{ page.title }} | {{ profile.name }}{% endcapture %}
{% else %}
  {% assign page_title = profile.name %}
{% endif %}
{% assign page_url = page.url | replace: 'index.html', '' | absolute_url %}
{% assign social_image = page.og_image | default: site.og_image | absolute_url %}

{% if site.enable_google_verification and site.google_site_verification != blank %}
  <meta name="google-site-verification" content="{{ site.google_site_verification | escape }}">
{% endif %}
{% if site.enable_bing_verification and site.bing_site_verification != blank %}
  <meta name="msvalidate.01" content="{{ site.bing_site_verification | escape }}">
{% endif %}
<meta http-equiv="Permissions-Policy" content="interest-cohort=()">

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ page_title | strip | escape }}</title>
<meta name="author" content="{{ author_name | escape }}">
<meta name="description" content="{{ page_description | escape }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{{ page.keywords | default: site.keywords | escape }}">
{% endif %}

{% if site.serve_og_meta %}
  <meta property="og:site_name" content="{{ profile.name | escape }}">
  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ page_title | strip | escape }}">
  <meta property="og:url" content="{{ page_url | escape }}">
  <meta property="og:description" content="{{ page_description | escape }}">
  <meta property="og:image" content="{{ social_image | escape }}">
  <meta property="og:image:alt" content="Portrait of {{ profile.name | escape }}">
  <meta property="og:locale" content="{{ site.lang | escape }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ page_title | strip | escape }}">
  <meta name="twitter:description" content="{{ page_description | escape }}">
  <meta name="twitter:image" content="{{ social_image | escape }}">
  <meta name="twitter:image:alt" content="Portrait of {{ profile.name | escape }}">
  {% if site.data.socials.x_username %}
    <meta name="twitter:site" content="@{{ site.data.socials.x_username | escape }}">
    <meta name="twitter:creator" content="@{{ site.data.socials.x_username | escape }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfilePage",
          "@id": {{ profile.url | append: "#profile-page" | jsonify }},
          "url": {{ profile.url | jsonify }},
          "name": {{ page_title | strip | jsonify }},
          "description": {{ profile.description | jsonify }},
          "mainEntity": { "@id": {{ profile.url | append: "#person" | jsonify }} },
          "isPartOf": { "@id": {{ profile.url | append: "#website" | jsonify }} }
        },
        {
          "@type": "Person",
          "@id": {{ profile.url | append: "#person" | jsonify }},
          "name": {{ profile.name | jsonify }},
          "givenName": {{ profile.given_name | jsonify }},
          "additionalName": {{ profile.additional_name | jsonify }},
          "familyName": {{ profile.family_name | jsonify }},
          "alternateName": {{ profile.alternate_names | jsonify }},
          "url": {{ profile.url | jsonify }},
          "image": {{ profile.image | jsonify }},
          "jobTitle": {{ profile.job_title | jsonify }},
          "description": {{ profile.description | jsonify }},
          "worksFor": {
            "@type": "Organization",
            "name": {{ profile.employer.name | jsonify }},
            "sameAs": {{ profile.employer.url | jsonify }}
          },
          "alumniOf": [
            {% for school in profile.education %}
              {
                "@type": "CollegeOrUniversity",
                "name": {{ school.name | jsonify }},
                "sameAs": {{ school.url | jsonify }}
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ],
          "knowsAbout": {{ profile.focus_areas | jsonify }},
          "sameAs": {{ profile.same_as | jsonify }}
        },
        {
          "@type": "WebSite",
          "@id": {{ profile.url | append: "#website" | jsonify }},
          "url": {{ profile.url | jsonify }},
          "name": {{ profile.name | jsonify }},
          "description": {{ profile.description | jsonify }},
          "author": { "@id": {{ profile.url | append: "#person" | jsonify }} }
        }
      ]
    }
  </script>
{% endif %}
